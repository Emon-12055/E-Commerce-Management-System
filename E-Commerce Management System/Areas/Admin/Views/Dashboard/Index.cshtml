@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="h3 mb-4">Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Products</div>
            <div class="display-6">@Model.TotalProducts</div>
            <div class="small text-success">@Model.ActiveProducts active</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Categories</div>
            <div class="display-6">@Model.TotalCategories</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Orders</div>
            <div class="display-6">@Model.TotalOrders</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Customers / Staff</div>
            <div class="display-6">@Model.TotalCustomers <span class="fs-5 text-muted">/ @Model.TotalStaff</span></div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Low stock (@Model.LowStockThreshold or less)</strong>
        <a asp-controller="Inventory" asp-action="Index" asp-route-lowOnly="true" class="btn btn-sm btn-outline-primary">Manage stock</a>
    </div>
    @if (!Model.LowStockItems.Any())
    {
        <div class="card-body text-muted">All variants have enough stock.</div>
    }
    else
    {
        <table class="table mb-0 align-middle">
            <thead class="table-light"><tr><th>Product</th><th>Size</th><th>Color</th><th class="text-end">Stock</th></tr></thead>
            <tbody>
                @foreach (var v in Model.LowStockItems)
                {
                    <tr>
                        <td>@v.Product?.Name</td>
                        <td>@v.Size</td>
                        <td>@v.Color</td>
                        <td class="text-end">
                            <span class="badge @(v.StockQuantity == 0 ? "bg-danger" : "bg-warning text-dark")">@v.StockQuantity</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
