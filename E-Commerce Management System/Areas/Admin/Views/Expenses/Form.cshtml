@model Expense
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit expense" : "Add expense";
    var categoryItems = Enum.GetValues<ExpenseCategory>()
        .Select(c => new SelectListItem(ReportDisplay.Label(c), c.ToString(), Model.Category == c));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="card shadow-sm" style="max-width:640px">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id.ToString() : null)" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" asp-items="categoryItems" class="form-select"></select>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" placeholder="e.g. Shop rent for November" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label">Amount (৳)</label>
                    <input asp-for="Amount" class="form-control" step="0.01" min="0" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-3">@(isEdit ? "Save changes" : "Save expense")</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
