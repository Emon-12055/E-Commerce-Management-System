@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />

@* ---------- Hero banner ---------- *@
<section class="hero rounded-4 p-4 p-md-5 mb-5 text-white">
    <div class="col-lg-7">
        <h1 class="display-5 fw-bold">New season, new style</h1>
        <p class="lead mb-4">Shop the latest clothing in every size and color. Easy ordering and fast delivery.</p>

        <form asp-controller="Shop" asp-action="Index" method="get" class="d-flex gap-2" style="max-width:520px">
            <input type="text" name="search" class="form-control form-control-lg" placeholder="Search products..." />
            <button type="submit" class="btn btn-light btn-lg px-4">Search</button>
        </form>
    </div>
</section>

@* Categories, featured products and new arrivals come from the HomeProducts view component *@
@await Component.InvokeAsync("HomeProducts")
