@using ECommerceManagementSystem.Models
@using ECommerceManagementSystem.ViewModels
@model Order
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
    var payment = Model.Payments.OrderByDescending(p => p.Id).FirstOrDefault();
    bool canCancel = Model.Status is OrderStatus.Pending or OrderStatus.Confirmed;
    bool canPay = Model.Status == OrderStatus.Pending && payment != null
                  && payment.Method != PaymentMethod.CashOnDelivery && payment.Status != PaymentStatus.Paid;

    // Tracking steps
    var steps = new[]
    {
        (Status: OrderStatus.Pending, Title: "Order placed", Icon: "📝"),
        (Status: OrderStatus.Confirmed, Title: "Confirmed", Icon: "✔️"),
        (Status: OrderStatus.Processing, Title: "Packing", Icon: "📦"),
        (Status: OrderStatus.Shipped, Title: "Shipped", Icon: "🚚"),
        (Status: OrderStatus.Delivered, Title: "Delivered", Icon: "🏠")
    };
    bool stopped = Model.Status is OrderStatus.Cancelled or OrderStatus.Returned;
    int currentStep = stopped ? -1 : Array.FindIndex(steps, s => s.Status == Model.Status);
}

<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show">@ok<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
    <div>
        <a asp-action="Index" class="small text-decoration-none">&larr; My orders</a>
        <h1 class="h3 mb-1">Order @Model.OrderNumber</h1>
        <div class="text-muted small">Placed on @OrderDisplay.Local(Model.OrderDate).ToString("dd MMM yyyy, h:mm tt")</div>
    </div>
    <div class="d-flex gap-2">
        @if (canPay)
        {
            <form asp-action="Pay" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success">💳 Pay now ৳ @Model.Total.ToString("N0")</button>
            </form>
        }
        @if (canCancel)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Are you sure you want to cancel this order?');">
                <button type="submit" class="btn btn-outline-danger">Cancel order</button>
            </form>
        }
    </div>
</div>

@* ---------- Tracking ---------- *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5 mb-3">Order tracking</h2>

        @if (stopped)
        {
            <div class="alert alert-secondary mb-0">
                This order was <strong>@Model.Status.ToString().ToLower()</strong>.
            </div>
        }
        else
        {
            <div class="tracking d-flex justify-content-between">
                @for (int i = 0; i < steps.Length; i++)
                {
                    var state = i < currentStep ? "done" : i == currentStep ? "current" : "todo";
                    <div class="tracking-step @state text-center flex-fill">
                        <div class="tracking-dot mx-auto mb-1">@steps[i].Icon</div>
                        <div class="small fw-semibold">@steps[i].Title</div>
                        @if (steps[i].Status == OrderStatus.Pending)
                        {
                            <div class="small text-muted">@OrderDisplay.Local(Model.OrderDate).ToString("dd MMM")</div>
                        }
                        @if (steps[i].Status == OrderStatus.Shipped && Model.ShippedAt.HasValue)
                        {
                            <div class="small text-muted">@OrderDisplay.Local(Model.ShippedAt.Value).ToString("dd MMM")</div>
                        }
                        @if (steps[i].Status == OrderStatus.Delivered && Model.DeliveredAt.HasValue)
                        {
                            <div class="small text-muted">@OrderDisplay.Local(Model.DeliveredAt.Value).ToString("dd MMM")</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="row g-4">
    @* ---------- Items ---------- *@
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Items</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item px-0 d-flex gap-3 align-items-center">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="" class="rounded-2" style="width:56px;height:70px;object-fit:cover" />
                            }
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@item.ProductName</div>
                                <div class="small text-muted">Size: @item.Size · Color: @item.Color · ৳ @item.UnitPrice.ToString("N0") × @item.Quantity</div>
                            </div>
                            <div class="fw-semibold text-nowrap">৳ @item.LineTotal.ToString("N0")</div>
                        </li>
                    }
                </ul>

                <hr />
                <div class="d-flex justify-content-between"><span>Subtotal</span><span>৳ @Model.SubTotal.ToString("N0")</span></div>
                <div class="d-flex justify-content-between"><span>Shipping</span><span>৳ @Model.ShippingCost.ToString("N0")</span></div>
                @if (Model.Discount > 0)
                {
                    <div class="d-flex justify-content-between text-success"><span>Discount</span><span>- ৳ @Model.Discount.ToString("N0")</span></div>
                }
                <div class="d-flex justify-content-between fs-5 fw-bold mt-2"><span>Total</span><span>৳ @Model.Total.ToString("N0")</span></div>
            </div>
        </div>
    </div>

    @* ---------- Delivery + payment ---------- *@
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h6 fw-bold">Delivery address</h2>
                <div>@Model.ShippingFullName</div>
                <div class="text-muted small">@Model.ShippingPhone</div>
                <div class="text-muted small">@Model.ShippingAddressLine, @Model.ShippingCity @Model.ShippingPostalCode</div>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="small mt-2"><span class="text-muted">Note:</span> @Model.Notes</div>
                }
            </div>
        </div>

        @if (payment != null)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h6 fw-bold">Payment</h2>
                    <div>@OrderDisplay.Label(payment.Method)</div>
                    <span class="badge @OrderDisplay.Badge(payment.Status)">@payment.Status</span>
                    @if (payment.PaidAt.HasValue)
                    {
                        <div class="small text-muted mt-1">Paid on @OrderDisplay.Local(payment.PaidAt.Value).ToString("dd MMM yyyy, h:mm tt")</div>
                    }
                    @if (payment.Method == PaymentMethod.CashOnDelivery && payment.Status == PaymentStatus.Pending)
                    {
                        <div class="small text-muted mt-1">Pay ৳ @Model.Total.ToString("N0") in cash on delivery.</div>
                    }
                </div>
            </div>
        }
    </div>
</div>
