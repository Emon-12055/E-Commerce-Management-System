@model ECommerceManagementSystem.ViewModels.HomeProductsViewModel

@* ---------- Categories ---------- *@
@if (Model.Categories.Any())
{
    <section class="mb-5">
        <h2 class="h4 mb-3">Shop by category</h2>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var c in Model.Categories)
            {
                <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@c.Id"
                   class="btn btn-outline-dark rounded-pill px-4">@c.Name</a>
            }
            <a asp-controller="Shop" asp-action="Index" class="btn btn-dark rounded-pill px-4">All products</a>
        </div>
    </section>
}

@* ---------- Featured ---------- *@
@if (Model.Featured.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Featured</h2>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var p in Model.Featured)
            {
                <div class="col"><partial name="_ProductCard" model="p" /></div>
            }
        </div>
    </section>
}

@* ---------- New arrivals ---------- *@
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">New arrivals</h2>
        <a asp-controller="Shop" asp-action="Index" class="text-decoration-none">View all &rarr;</a>
    </div>

    @if (!Model.NewArrivals.Any())
    {
        <div class="alert alert-light border">No products yet. Add some from the Admin Panel.</div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var p in Model.NewArrivals)
            {
                <div class="col"><partial name="_ProductCard" model="p" /></div>
            }
        </div>
    }
</section>
