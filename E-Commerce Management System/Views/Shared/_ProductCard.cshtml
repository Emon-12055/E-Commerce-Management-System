@model ECommerceManagementSystem.ViewModels.ProductCardViewModel

<div class="card h-100 border-0 shadow-sm product-card">
    <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="position-relative d-block">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="card-img-top product-img" loading="lazy" />
        }
        else
        {
            <div class="card-img-top product-img d-flex align-items-center justify-content-center text-muted bg-light">No image</div>
        }

        @if (Model.OnSale)
        {
            <span class="badge bg-danger position-absolute top-0 start-0 m-2">-@Model.DiscountPercent%</span>
        }
        @if (!Model.InStock)
        {
            <span class="badge bg-dark position-absolute top-0 end-0 m-2">Out of stock</span>
        }
    </a>

    <div class="card-body d-flex flex-column">
        @if (!string.IsNullOrEmpty(Model.CategoryName))
        {
            <div class="small text-muted mb-1">@Model.CategoryName</div>
        }
        <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id"
           class="text-decoration-none text-dark fw-semibold mb-2 product-name">@Model.Name</a>

        <div class="mt-auto">
            <span class="fs-5 fw-bold">৳ @Model.Price.ToString("N0")</span>
            @if (Model.OnSale)
            {
                <span class="text-muted text-decoration-line-through small ms-1">৳ @Model.CompareAtPrice!.Value.ToString("N0")</span>
            }
        </div>
    </div>
</div>
