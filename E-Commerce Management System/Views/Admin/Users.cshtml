@model List<ECommerceManagementSystem.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Users";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Users</h2>
    <a asp-action="CreateStaff" class="btn btn-primary">+ Add staff</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Role</th>
            <th>Status</th>
            <th>Joined</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.FullName</td>
                <td>@u.Email</td>
                <td>@(u.PhoneNumber ?? "-")</td>
                <td><span class="badge bg-dark">@u.Roles</span></td>
                <td>
                    @if (u.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Disabled</span>
                    }
                </td>
                <td>@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                <td>
                    @if (u.Id != currentUserId)
                    {
                        <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(u.IsActive ? "Disable" : "Enable")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-link">&larr; Back to dashboard</a>